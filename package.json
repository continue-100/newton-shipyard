{
	"name": "newton-shipyard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:backend": "bun test src/lib/server",
		"seed:demo": "bun src/lib/server/seed-demo.ts",
		"test": "bun run test:backend && bun run --bun test:unit --run && bun run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mdsvex/plugin-anchors": "^0.1.0",
		"@mdsvex/plugin-code-blocks": "^0.1.0",
		"@mdsvex/plugin-elements": "^0.1.0",
		"@mdsvex/plugin-embeds": "^0.1.0",
		"@mdsvex/plugin-external-links": "^0.1.0",
		"@mdsvex/plugin-figures": "^0.1.0",
		"@mdsvex/plugin-link-check": "^0.1.0",
		"@mdsvex/plugin-page-data": "^0.1.0",
		"@mdsvex/plugin-references": "^0.1.0",
		"@mdsvex/prettier-plugin": "^0.1.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-bun": "^1.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.5",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-rolldown": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"@vitejs/devtools-vitest": "^0.8.3",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^1.0.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.108.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"animejs": "^4.5.0",
		"nodemailer": "^10.6.1",
		"phosphor-svelte": "^3.1.1",
		"shaders": "^4.0.7"
	}
}
